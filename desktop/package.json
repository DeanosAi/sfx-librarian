{
  "name": "editors-librarian",
  "version": "0.1.5",
  "description": "Searchable indexed library for editors — SFX, music, B-roll, and more.",
  "main": "main.js",
  "author": "Dean Bradnam",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "build": {
    "appId": "com.deanbradnam.editors-librarian",
    "productName": "Editors Librarian",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/drag-icon.png", "to": "drag-icon.png" }
    ],
    "afterPack": "build/afterPack.js",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
